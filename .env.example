# Both blank means guest-only mode. Copy actual values from your Supabase project.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Never put service-role/secret keys or AI provider keys in VITE_* variables.
# Optional server-only test environment: SUPABASE_TEST_URL,
# SUPABASE_TEST_PUBLISHABLE_KEY, SUPABASE_TEST_SERVICE_ROLE_KEY.

# V2.2: set these ONLY as Supabase Edge secrets (never VITE_*):
# AI_PROVIDER=gemini
# AI_MODEL=<available model selected in your provider account>
# AI_API_KEY=<server secret>
# GROQ_FALLBACK_MODEL=<optional available Groq model>
# GROQ_FALLBACK_KEY=<optional server secret>
# Auth redirect allowlist: https://shadabur-rahaman.github.io/datum/#/settings
